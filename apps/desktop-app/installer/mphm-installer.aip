<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<DOCUMENT type="Advanced Installer" CreateVersion="18.0" Format="18.0" >
  <COMPONENT cid="caphyon.advinst.msicomp.MsiPropsComponent">
    <ROW Property="ProductName" Value="Admin Mubtadiaat" Type="1"/>
    <ROW Property="ProductVersion" Value="1.4.17" Type="1"/>
    <ROW Property="Manufacturer" Value="P3HM &amp; MPHM Lirboyo Kediri" Type="1"/>
    <ROW Property="ARPCOMMENTS" Value="Sistem Manajemen Sekretariat Pondok &amp; Madrasah Putri Hidayatul Mubtadi'aat Lirboyo" Type="1"/>
    <ROW Property="SecureCustomProperties" Value="INSTALLER_USERNAME;INSTALLER_PASSWORD;LOGIN_STATUS" Type="1"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiThemeComponent">
    <ROW Theme="Surface" Style="ModernDark" macOSStyle="true"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiCustomActionComponent">
    <ROW Action="VerifySekretariatLogin" Type="2048" Target="https://m.p3hm.my.id/api/v1/installer/login" Title="Verifikasi Otentikasi Pengurus Sekretariat"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiRegsComponent">
    <ROW Registry="URL_Protocol" Root="2" Key="Software\Classes\mphm" Name="URL Protocol" Value="" Type="1"/>
    <ROW Registry="URL_Command" Root="2" Key="Software\Classes\mphm\shell\open\command" Name="" Value="&quot;[APPDIR]Admin Mubtadiaat.exe&quot; &quot;%1&quot;" Type="1"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiInstallUISequenceComponent">
    <ROW Action="SekretariatAuthDlg" Sequence="1200" Condition="NOT Installed"/>
    <ROW Action="ExtractionProgressDlg" Sequence="1300" Condition="NOT Installed"/>
    <ROW Action="FinishmacOSDlg" Sequence="1400" Condition="NOT Installed"/>
  </COMPONENT>
</DOCUMENT>
