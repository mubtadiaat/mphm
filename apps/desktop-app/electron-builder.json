{
  "appId": "com.p3hm.sekretariat.desktop",
  "productName": "Admin Mubtadiaat",
  "protocols": [
    {
      "name": "MPHM Auth Protocol",
      "schemes": [
        "mphm"
      ]
    }
  ],
  "directories": {
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "package.json",
    "p3hm-code-signing.pfx"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "src/assets/logo.png",
    "certificateFile": "p3hm-code-signing.pfx",
    "publisherName": "Admin Mubtadiaat Ecosystem",
    "verifyUpdateCodeSignature": false,
    "publish": [
      {
        "provider": "github",
        "owner": "mubtadiaat",
        "repo": "app_software"
      }
    ]
  },
  "nsis": {
    "include": "installer/uninstaller.nsh",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "displayLanguageSelector": false,
    "perMachine": false,
    "shortcutName": "Admin Mubtadiaat",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": true,
    "runAfterFinish": true
  }
}
